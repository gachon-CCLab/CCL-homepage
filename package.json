{
  "name": "ccl-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "tsx scripts/documents.ts && vite --host 127.0.0.1 --port 4333",
    "build": "tsc --noEmit && tsx scripts/build.tsx",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4333",
    "verify:content": "python tools/verify-content.py",
    "package": "python tools/package.py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.6"
  }
}
